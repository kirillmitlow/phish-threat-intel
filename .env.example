# Настройки подключения к ИИ-серверу НГУ (Open WebUI / DeepCode)
AI_BASE_URL=http://deepcode.ci.nsu.ru/api/chat/completions
AI_API_KEY=

# Внутренний URL песочницы (внутри Docker app_network). Агент -> Sandbox.
SANDBOX_URL=http://sandbox_service:8400

# Названия моделей по умолчанию
DEFAULT_LLM_MODEL=Qwen3.8-27B
DEFAULT_VLM_MODEL=Qwen3.8-27B

# Системные настройки
ENVIRONMENT=development
LOG_LEVEL=INFO